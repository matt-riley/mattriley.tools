---
import Seo from "@jdevalk/astro-seo-graph/Seo.astro";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  agentHint?: string | readonly string[];
  jsonld?: unknown;
  pageTitle?: string;
  ogType?: string;
  noindex?: boolean;
}
const { title, description, agentHint, jsonld, pageTitle, ogType = "website", noindex = false } = Astro.props;
const agentHintHtml = agentHint
  ? `<!-- AGENT DISCOVERY HINT:\n${Array.isArray(agentHint) ? agentHint.join("\n") : agentHint}\n-->`
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <Seo
      title={pageTitle ?? `${title} | mattriley.tools`}
      description={description}
      canonicalUrl={new URL(Astro.url.pathname, Astro.site).href}
      ogImage="https://mattriley.tools/og-default.png"
      ogImageWidth={1200}
      ogImageHeight={630}
      ogImageAlt="Under Pressure, a print exhibition by Matt Riley"
      siteName="mattriley.tools"
      twitter={{ site: "@mattriley" }}
      ogType={ogType}
      noindex={noindex}
    />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a href="#content" class="skip">
      Skip to content
    </a>
    <header class="mast">
      <div class="wrap mast-inner">
        <a class="brand" href="/">
          <i class="register" aria-hidden="true"></i>mattriley.tools
        </a>
        <span class="mast-rule" aria-hidden="true"></span>
        <nav aria-label="Main navigation">
          <a href="/#plates">Exhibition</a>
          <a href="/#index">Tool index</a>
          <a href="https://github.com/matt-riley">GitHub</a>
        </nav>
      </div>
    </header>
    <div id="content" tabindex="-1">
      <slot />
    </div>
    <footer class="wrap colophon">
      <a class="brand" href="/">
        <i class="register" aria-hidden="true"></i>mattriley.tools
      </a>
      <span>Printed on the web by Matt Riley</span>
      <a href="#content">Back to top ↑</a>
    </footer>
    {agentHint && <Fragment set:html={agentHintHtml} />}
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          const command = button.dataset.copy!;
          try {
            await navigator.clipboard.writeText(command);
          } catch {
            const area = document.createElement("textarea");
            area.value = command;
            document.body.append(area);
            area.select();
            const copied = document.execCommand("copy");
            area.remove();
            button.focus();
            if (!copied) return;
          }
          const label = button.querySelector("[data-copy-label]")!;
          label.textContent = "Copied";
          window.setTimeout(() => {
            label.textContent = "Copy";
          }, 1600);
        });
      }
    </script>
  </body>
</html>
