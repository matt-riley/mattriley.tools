---
import CatalogDetail from "../../components/CatalogDetail.astro";
import { generatedAt, tools } from "../../data/tools.generated";
import { formatSeoDescription, formatSeoTitle } from "../../utils/seo";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.name,
  description: tool.description,
  url: `https://mattriley.tools/tools/${tool.slug}/`,
  sameAs: tool.homepage,
  softwareVersion: tool.version,
  applicationCategory: "DeveloperApplication",
  operatingSystem: tool.platforms.join(", "),
  ...(tool.license ? { license: tool.license } : {}),
};
---

<CatalogDetail
  title={formatSeoTitle(tool.name, "Homebrew Tool")}
  description={formatSeoDescription(tool.description, `Install ${tool.name} with ${tool.installCommand}.`)}
  agentHint={[
    `This is the detail page for the ${tool.name} Homebrew tool.`,
    "Formula metadata is the source of truth for version, install command, binaries, and platform support.",
    "README content is synced from the linked GitHub repository when available.",
  ]}
  jsonld={jsonld}
  domainClass="vibrant-cyan"
  name={tool.name}
  subtitle={tool.description}
  generatedAt={generatedAt}
  sourceHref={tool.homepage}
  sourceLabel="Open source repository"
  sectionTitle="README"
  sectionAnchor="tools"
  fallbackText="This tool does not currently have synced README content to display."
  readme={tool.readme}
  ogType="article"
>
  <Fragment slot="metadata">
    <div><span class="key">Version:</span> <span class="value">{tool.version}</span></div>
    <div><span class="key">Binaries:</span> <span class="value">{Number(tool.binaryNames.length)}</span></div>
    <div><span class="key">Platforms:</span> <span class="value">{Number(tool.platforms.length)}</span></div>
    <div><span class="key">License:</span> <span class="value">{tool.license ?? "Undeclared"}</span></div>
    {tool.homepage && (
      <div><a href={tool.homepage} target="_blank" rel="noopener noreferrer">Homepage ↗</a></div>
    )}
  </Fragment>

  <Fragment slot="extra">
    <div class="install-panel">
      <p class="install-label">Install</p>
      <div class="install-block">
        <span class="prompt" aria-hidden="true">$</span>
        <code>{tool.installCommand}</code>
        <button
          class="copy-btn"
          type="button"
          data-copy={tool.installCommand}
          aria-label={`Copy install command for ${tool.name}`}
        >
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>
  </Fragment>
</CatalogDetail>
