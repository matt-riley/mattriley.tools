---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="This page is missing from Matt Riley’s software exhibition. Return to the index to explore the published tools, plugins and templates."
  noindex={true}
>
  <main class="wrap misprint">
    <div class="misprint-copy">
      <p class="mono">404 / Missing impression</p>
      <h1>
        Off the <br />
        plate.
      </h1>
      <p>This page slipped out of the edition.</p>
      <a class="ink-button" href="/#index">
        Back to the index <span aria-hidden="true">←</span>
      </a>
    </div>
    <figure class="waste-sheet">
      <div class="lost-face">
        <span class="wrong-number" aria-hidden="true">
          404
        </span>
        <button class="register-button" type="button" aria-label="Align the printing plates" hidden>
          <i class="register" aria-hidden="true"></i>
        </button>
      </div>
      <figure class="night-proof" hidden>
        <img
          src="/prints/night-shift.webp"
          width="1536"
          height="1024"
          alt="An engraved moth spreads its patterned wings across a cobalt star chart."
          loading="lazy"
        />
        <figcaption>
          <em>Night shift</em>
          <span class="mono">Artist’s proof / 404</span>
        </figcaption>
      </figure>
      <div class="proof-foot">
        <span class="mono" id="alignment" role="status">
          Out of register
        </span>
        <a
          href="/prints/night-shift.webp"
          download="night-shift-artists-proof.webp"
          class="secret-download"
          hidden
        >
          Keep this print ↓
        </a>
      </div>
    </figure>
  </main>
</Layout>
<script>
  import { gsap } from "gsap";
  const mark = document.querySelector<HTMLButtonElement>(".register-button")!;
  const face = document.querySelector<HTMLElement>(".lost-face")!;
  const proof = document.querySelector<HTMLElement>(".night-proof")!;
  const keep = document.querySelector<HTMLAnchorElement>(".secret-download")!;
  const label = document.querySelector<HTMLElement>("#alignment")!;
  const number = document.querySelector<HTMLElement>(".wrong-number")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let passes = 0;
  mark.hidden = false;
  mark.addEventListener("click", () => {
    passes++;
    if (passes < 4) {
      number.style.setProperty("--offset", (4 - passes) * 4 + "px");
      label.textContent = "Registration pass " + passes + " / 4";
      if (!reduced.matches)
        gsap.fromTo(
          number,
          { x: 7 - passes, rotation: -1 },
          { x: 0, rotation: 0, duration: 0.22, overwrite: true },
        );
      return;
    }
    face.hidden = true;
    proof.hidden = false;
    keep.hidden = false;
    label.textContent = "In register · Fourth plate found";
    keep.focus({ preventScroll: true });
    if (!reduced.matches)
      gsap.from(proof, { clipPath: "inset(49.8% 0)", duration: 0.75, ease: "power3.inOut" });
  });
</script>
<style>
  .misprint {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    align-items: center;
    gap: 5%;
    padding-block: clamp(40px, 7vw, 120px);
  }
  h1 {
    font: 400 clamp(74px, 9vw, 150px)/0.99 var(--display);
    text-transform: uppercase;
    letter-spacing: -0.04em;
    margin: 16px 0;
  }
  .ink-button {
    margin-top: 20px;
  }
  .waste-sheet {
    min-width: 0;
  }
  .lost-face {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1.5;
    background: var(--paper) url("/prints/paper.png");
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .wrong-number {
    --offset: 16px;
    font: 400 clamp(120px, 18vw, 330px)/1 var(--display);
    letter-spacing: -0.06em;
    text-shadow:
      var(--offset) -4px var(--red),
      calc(-1 * var(--offset)) 4px var(--blue);
  }
  .register-button {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--paper);
    border-radius: 50%;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
  }
  .register-button:hover {
    color: var(--red);
  }
  .proof-foot,
  .night-proof figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }
  .night-proof img {
    width: 100%;
    height: auto;
  }
  .secret-download {
    white-space: nowrap;
    font: 600 0.78rem var(--mono);
    text-underline-offset: 4px;
  }
  @media (max-width: 650px) {
    .misprint {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 32px;
    }
    .misprint-copy h1 br {
      display: none;
    }
    .misprint-copy h1 {
      font-size: 16vw;
    }
    .wrong-number {
      font-size: 36vw;
    }
  }
</style>
