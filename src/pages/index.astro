---
import Layout from "../layouts/Layout.astro";
import PrintRoom from "../components/PrintRoom.astro";
import { collections, plates } from "../data/exhibition";
import { generatedAt } from "../data/tools.generated";
import { formatUtcTimestamp } from "../utils/date";

const description =
  "Explore Matt Riley’s Homebrew tools, Neovim plugins and software templates through interactive print studies, working examples and a searchable index.";
const total = collections.reduce((sum, collection) => sum + collection.entries.length, 0);
const folio = (n: number) => String(n).padStart(2, "0");
const cover = plates[0];
const pageUrl = new URL("/", Astro.site).href;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Under Pressure",
  url: pageUrl,
  description,
  hasPart: collections.map((c) => ({
    "@type": "ItemList",
    name: c.label,
    numberOfItems: c.entries.length,
    url: pageUrl + "#" + c.id,
  })),
};
---

<Layout
  title="Under Pressure"
  pageTitle="Under Pressure — Software prints by Matt Riley"
  description={description}
  jsonld={jsonld}
>
  <main class="wrap">
    <section class="spread" aria-labelledby="title">
      <div class="intro">
        <h1 id="title">
          <span class="type-line">
            <b>Under</b>
          </span>
          <span class="type-line">
            <b>
              Pressure<i>.</i>
            </b>
          </span>
        </h1>
        <p>A print exhibition of software tools by Matt Riley. Each instrument leaves a different mark.</p>
        <a class="ink-button" href={cover ? "#plates" : "#index"}>
          {cover ? "Explore the plates" : "Browse the index"} <span aria-hidden="true">↓</span>
        </a>
      </div>
      {cover && (
        <figure class="cover">
          <div class="cover-frame">
            <div class="cover-line mono">
              <span>
                Fig. <b data-cover-number>01</b>
              </span>
              <span data-medium>{cover.medium}</span>
            </div>
            <a
              href={`/${cover.route}/${cover.id}/`}
              data-cover-link
              data-open={cover.id}
              class="cover-art"
              aria-label={`Explore ${cover.title}`}
            >
              <img
                data-cover-image
                src={cover.image}
                alt={cover.alt}
                width="1536"
                height="1024"
                fetchpriority="high"
              />
              <i class="ink-pass" aria-hidden="true"></i>
              <i class="loupe" aria-hidden="true"></i>
              <span class="proof-tag" data-enhance hidden>
                Work this plate
              </span>
            </a>
            <i class="corner tl"></i>
            <i class="corner tr"></i>
            <i class="corner bl"></i>
            <i class="corner br"></i>
          </div>
          <figcaption>
            <span class="cover-caption">
              <em data-cover-title>{cover.title}</em>
              <span aria-hidden="true"> / </span>
              <span data-cover-id>{cover.id}</span>
            </span>
            <div class="turns" data-enhance hidden>
              <button data-turn="-1" aria-label="Previous plate">
                ←
              </button>
              <span class="mono">
                <b data-position>01</b> / {folio(plates.length)}
              </span>
              <button data-turn="1" aria-label="Next plate">
                →
              </button>
            </div>
          </figcaption>
        </figure>
      )}
    </section>
    <div class="pressline">
      <div class="palette">
        <span>Printer’s palette</span>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span class="press-edition">An independent web edition</span>
      <span>
        Matt Riley <span aria-hidden="true">/</span> Software &amp; print
      </span>
    </div>
    {plates.length > 0 && (
      <section id="plates" class="plate-section">
        <div class="section-head">
          <h2>Selected plates</h2>
          <span class="section-rule"></span>
          <span class="section-note">Studies from the collection</span>
        </div>
        <div class="plate-grid">
          {plates.map((p, i) => (
            <a class="plate-card" href={`/${p.route}/${p.id}/`} data-open={p.id}>
              <div class="thumb">
                <img src={p.image} alt={p.alt} width="840" height="540" loading="eager" />
                <span class="plate-tab">Pl. {folio(i + 1)}</span>
              </div>
              <div class="card-heading">
                <h3>{p.title}</h3>
              </div>
              <span class="spec-id">
                {p.id} <b>·</b> {p.medium}
              </span>
              <p>{p.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
    <section id="index" class="index">
      <div class="section-head">
        <h2>Tool index</h2>
        <span class="section-rule"></span>
        <span class="section-note">{total} published works</span>
      </div>
      <div class="index-controls" data-enhance hidden>
        <label class="search">
          <span aria-hidden="true">⌕</span>
          <input
            type="search"
            aria-label="Search the tool index"
            placeholder="Search the index…"
            id="search"
          />
        </label>
        <label class="filter">
          Collection{" "}
          <select id="collection">
            <option value="">All works</option>
            {collections.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))}
          </select>
        </label>
      </div>
      {collections.map((c) => (
        <section class="collection" id={c.id} data-group={c.id}>
          <h3>
            {c.label} <small>{folio(c.entries.length)}</small>
          </h3>
          {c.entries.map((entry) => (
            <a class="index-row" href={`/${c.route}/${entry.slug}/`}>
              <strong>{entry.name}</strong>
              <span>{entry.description}</span>
              <small class="version">{"version" in entry ? "v" + entry.version : entry.language}</small>
            </a>
          ))}
          {!Number(c.entries.length) && <p>No published entries yet.</p>}
        </section>
      ))}
      <p class="no-results" hidden>
        No works match this search.{" "}
        <button type="button" id="clear-search">
          Clear filters
        </button>
      </p>
      <span class="sr-only" role="status" id="result-count"></span>
      <p class="sync mono">
        Catalogue refreshed <time datetime={generatedAt}>{formatUtcTimestamp(generatedAt)}</time>
      </p>
    </section>
  </main>
  {cover && <PrintRoom />}
  <script>
    import "../scripts/exhibition";
  </script>
</Layout>
