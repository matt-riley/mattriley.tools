---
import { plates } from "../data/exhibition";
import Layout from "../layouts/Layout.astro";
import { formatUtcTimestamp } from "../utils/date";
import { renderReadme, type SyncedReadme } from "../utils/readme";

interface Props {
  title: string;
  description: string;
  agentHint: string[];
  jsonld: unknown;
  name: string;
  subtitle: string;
  generatedAt: string;
  sourceHref: string;
  sourceLabel: string;
  sectionTitle: string;
  sectionAnchor: string;
  fallbackText: string;
  readme: SyncedReadme;
  ogType?: string;
}

const {
  title,
  description,
  agentHint,
  jsonld,
  name,
  subtitle,
  generatedAt,
  sourceHref,
  sourceLabel,
  sectionTitle,
  sectionAnchor,
  fallbackText,
  readme,
  ogType,
} = Astro.props;

const formattedGeneratedAt = formatUtcTimestamp(generatedAt);
const readmeHtml = renderReadme(readme);

const domainLabels: Record<string, string> = {
  tools: "Homebrew Tool",
  plugins: "Neovim Plugin",
  templates: "Public Template",
};
const plate = plates.find((p) => p.id === name && p.route === sectionAnchor);
const domainLabel = domainLabels[sectionAnchor] ?? "Catalog entry";

const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://mattriley.tools/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tool index",
      item: "https://mattriley.tools/#index",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: name,
    },
  ],
};

const combinedJsonld = {
  ...(typeof jsonld === "object" && jsonld !== null ? jsonld : {}),
  mainEntity: breadcrumbList,
};
---

<Layout title={title} description={description} agentHint={agentHint} jsonld={combinedJsonld} ogType={ogType}>
  <div data-reveal-scope>
    <main>
      <div class="detail-page">
        <div class="container">
          <a href="/#index" class="back-link">
            <span class="arrow" aria-hidden="true">
              ←
            </span>
            Back to tool index
          </a>

          <header>
            {plate && <img class="detail-print" src={plate.image} alt={plate.alt} width="260" height="170" />}
            <p class="detail-ribbon">{domainLabel}</p>
            <h1 data-reveal>{name}</h1>
            <p class="detail-sub">{subtitle}</p>

            <div class="detail-meta">
              <slot name="metadata" />
            </div>

            <slot name="extra" />
          </header>

          <section class="detail-main">
            <h2>{sectionTitle}</h2>
            {readme.markdown ? (
              <div class="readme-content" set:html={readmeHtml} />
            ) : (
              <p class="mono">{fallbackText}</p>
            )}
          </section>

          <footer class="detail-footer">
            <p>
              Last synced: <time datetime={generatedAt}>{formattedGeneratedAt}</time>
            </p>
            <p>
              <a href={sourceHref} target="_blank" rel="noopener noreferrer">
                {sourceLabel}
              </a>
            </p>
          </footer>
        </div>
      </div>
    </main>
  </div>
</Layout>
